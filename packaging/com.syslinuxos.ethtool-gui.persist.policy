<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <vendor>SysLinuxOS</vendor>
  <action id="com.syslinuxos.ethtool-gui.persist">
    <description>Save Ethernet settings for boot with Ethtool-GUI</description>
    <description xml:lang="it">Salva le impostazioni Ethernet per il boot con Ethtool-GUI</description>
    <message>Authentication is required to save Ethernet settings for boot</message>
    <message xml:lang="it">È richiesta l'autenticazione per salvare le impostazioni Ethernet per il boot</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ethtool-gui/ethtool-gui-persist</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
